# Use credentials from one Supabase project: Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key

# Season downloaded and written by the full pipeline.
FPL_DATA_SEASON=2026_27

# Optional Flask development settings.
FLASK_DEBUG=false
