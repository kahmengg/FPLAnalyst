# Example environment variables file
# Copy this to .env.local for local development

# Public Supabase connection used by the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Pin the active dataset and avoid an extra season discovery request
NEXT_PUBLIC_FPL_SEASON_KEY=2026_27
# Set true only when intentionally presenting a completed historical season.
NEXT_PUBLIC_FPL_SEASON_COMPLETE=false
