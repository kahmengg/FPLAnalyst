# Required for the browser frontend. Use the public/publishable key only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Legacy alternative if your project still uses anon JWT keys:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Optional: defaults to 2026_27 in the code when omitted.
NEXT_PUBLIC_FPL_SEASON_KEY=2026_27
NEXT_PUBLIC_FPL_SEASON_COMPLETE=false
